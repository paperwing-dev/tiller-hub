{
	"name": "tiller",
	"main": "api/index.ts",
	"compatibility_date": "2025-01-29",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"directory": "./dist/client"
	},
	"ai": {
		"binding": "AI"
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"vars": {
		// Required deploy-button choice. Enter one of:
		// wnam, enam, weur, eeur, apac, oc
		"TILLER_REGION": ""
	},
	"containers": [
		{
			"class_name": "SandboxDO",
			"image": "docker.io/jamieatlason/tiller-sandbox:stable",
			"max_instances": 2,
			"instance_type": "standard-1"
		},
		{
			"class_name": "GitHubJobDO",
			"image": "docker.io/jamieatlason/tiller-scm:stable",
			"max_instances": 4,
			"instance_type": "basic"
		},
		{
			// Planner runs need the coding CLIs + tiller-planner from the
			// sandbox image — never the CLI-less tiller-scm image.
			"class_name": "PlannerRunDO",
			"image": "docker.io/jamieatlason/tiller-sandbox:stable",
			"max_instances": 10,
			"instance_type": "standard-1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SCHEDULED_RUN_CAPACITY",
				"class_name": "ScheduledRunCapacityDO"
			},
			{
				"name": "ENV_LIFECYCLE",
				"class_name": "EnvLifecycleDO"
			},
			{
				"name": "ENV_REVIEW",
				"class_name": "EnvReviewDO"
			},
			{
				"name": "ARTIFACT_STORE",
				"class_name": "ArtifactStoreDO"
			},
			{
				"name": "HUB",
				"class_name": "HubDO"
			},
			{
				"name": "SANDBOX",
				"class_name": "SandboxDO"
			},
			{
				"name": "TILLER_VOICE",
				"class_name": "TillerVoice"
			},
			{
				"name": "GITHUB_JOB",
				"class_name": "GitHubJobDO"
			},
			{
				"name": "PLANNER_RUN",
				"class_name": "PlannerRunDO"
			},
			{
				"name": "THREAD",
				"class_name": "ThreadDO"
			},
			{
				"name": "WORKSPACE",
				"class_name": "WorkspaceDO"
			},
			{
				"name": "REVIEWER_CHAT",
				"class_name": "ReviewerChatAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"HubDO"
			]
		},
		{
			"tag": "v2",
			"new_classes": [
				"VoiceDO"
			]
		},
		{
			"tag": "v3",
			"deleted_classes": [
				"VoiceDO"
			],
			"new_sqlite_classes": [
				"HapiVoice"
			]
		},
		{
			"tag": "v4",
			"renamed_classes": [
				{
					"from": "HapiVoice",
					"to": "HelmVoice"
				}
			]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": [
				"SandboxDO"
			]
		},
		{
			"tag": "v6",
			"new_sqlite_classes": [
				"WorkspaceDO"
			]
		},
		{
			"tag": "v7",
			"new_sqlite_classes": [
				"ResearchChatAgent"
			]
		},
		{
			"tag": "v8",
			"new_sqlite_classes": [
				"ReviewerChatAgent"
			]
		},
		{
			"tag": "v9",
			"new_sqlite_classes": [
				"PlannerChatAgent"
			]
		},
		{
			"tag": "v10",
			"new_sqlite_classes": [
				"CartographerChatAgent"
			]
		},
		{
			"tag": "v11",
			"new_sqlite_classes": [
				"PlanChatAgent"
			]
		},
		{
			"tag": "v12",
			"renamed_classes": [
				{
					"from": "HelmVoice",
					"to": "TillerVoice"
				}
			]
		},
		{
			"tag": "v13",
			"new_sqlite_classes": [
				"RepoMergeLockDO"
			]
		},
		{
			"tag": "v14",
			"new_sqlite_classes": [
				"ScmBootstrapDO"
			]
		},
		{
			"tag": "v15",
			"new_sqlite_classes": [
				"EnvLifecycleDO"
			]
		},
		{
			"tag": "v16",
			"new_sqlite_classes": [
				"ArtifactStoreDO"
			]
		},
		{
			"tag": "v17",
			"new_sqlite_classes": [
				"ThreadDO"
			]
		},
		{
			"tag": "v18",
			"new_sqlite_classes": [
				"ScmOperationDO"
			]
		},
		{
			"tag": "v19",
			"deleted_classes": [
				"PlannerChatAgent"
			]
		},
		{
			"tag": "v20",
			"deleted_classes": [
				"ResearchChatAgent",
				"CartographerChatAgent"
			]
		},
		{
			"tag": "v21",
			"deleted_classes": [
				"PlanChatAgent"
			]
		},
		{
			"tag": "v22",
			"new_sqlite_classes": [
				"PlannerRunDO"
			]
		},
		{
			"tag": "v23",
			"new_sqlite_classes": [
				"GitHubJobDO"
			],
			"deleted_classes": [
				"RepoMergeLockDO",
				"ScmOperationDO",
				"ScmBootstrapDO"
			]
		},
		{
			"tag": "v24",
			"new_sqlite_classes": [
				"EnvReviewDO"
			]
		},
		{
			"tag": "v25",
			"new_sqlite_classes": [
				"ScheduledRunCapacityDO"
			]
		}
	],
	"kv_namespaces": [
		{
			"binding": "ENVS_KV"
		},
	],
	"workers_dev": true,
	"preview_urls": false,
	"send_metrics": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
