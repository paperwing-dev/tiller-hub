{
	"name": "tiller",
	"main": "api/index.ts",
	"compatibility_date": "2025-01-29",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"directory": "./dist/client"
	},
	"ai": {
		"binding": "AI"
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	"containers": [
		{
			"class_name": "SandboxDO",
			"image": "docker.io/jamieatlason/tiller-sandbox:stable",
			"max_instances": 30,
			"instance_type": "standard-1"
		},
		{
			"class_name": "GitHubJobDO",
			"image": "docker.io/jamieatlason/tiller-scm:stable",
			"max_instances": 4,
			"instance_type": "basic"
		},
		{
			// Planner runs need the coding CLIs + tiller-planner from the
			// sandbox image — never the CLI-less tiller-scm image.
			"class_name": "PlannerRunDO",
			"image": "docker.io/jamieatlason/tiller-sandbox:stable",
			"max_instances": 10,
			"instance_type": "standard-1"
		},
		{
			// One personal-deployment singleton. The inert container is woken
			// only for bounded tiller-codex-auth-helper executions.
			"class_name": "CodexAuthDO",
			"image": "docker.io/jamieatlason/tiller-sandbox:stable",
			"max_instances": 1,
			"instance_type": "basic"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SCHEDULED_RUN_CAPACITY",
				"class_name": "ScheduledRunCapacityDO"
			},
			{
				"name": "ENV_LIFECYCLE",
				"class_name": "EnvLifecycleDO"
			},
			{
				"name": "ENV_REVIEW",
				"class_name": "EnvReviewDO"
			},
			{
				"name": "ARTIFACT_STORE",
				"class_name": "ArtifactStoreDO"
			},
			{
				"name": "HUB",
				"class_name": "HubDO"
			},
			{
				"name": "CODEX_AUTH",
				"class_name": "CodexAuthDO"
			},
			{
				"name": "SANDBOX",
				"class_name": "SandboxDO"
			},
			{
				"name": "TILLER_VOICE",
				"class_name": "TillerVoice"
			},
			{
				"name": "GITHUB_JOB",
				"class_name": "GitHubJobDO"
			},
			{
				"name": "PLANNER_RUN",
				"class_name": "PlannerRunDO"
			},
			{
				"name": "THREAD",
				"class_name": "ThreadDO"
			},
			{
				"name": "WORKSPACE",
				"class_name": "WorkspaceDO"
			},
			{
				"name": "REVIEWER_CHAT",
				"class_name": "ReviewerChatAgent"
			}
			]
		},
	"exports": {
		"ScheduledRunCapacityDO": { "type": "durable-object", "storage": "sqlite" },
		"EnvLifecycleDO": { "type": "durable-object", "storage": "sqlite" },
		"EnvReviewDO": { "type": "durable-object", "storage": "sqlite" },
		"ArtifactStoreDO": { "type": "durable-object", "storage": "sqlite" },
		"HubDO": { "type": "durable-object", "storage": "sqlite" },
		"CodexAuthDO": { "type": "durable-object", "storage": "sqlite" },
		"SandboxDO": { "type": "durable-object", "storage": "sqlite" },
		"TillerVoice": { "type": "durable-object", "storage": "sqlite" },
		"GitHubJobDO": { "type": "durable-object", "storage": "sqlite" },
		"PlannerRunDO": { "type": "durable-object", "storage": "sqlite" },
		"ThreadDO": { "type": "durable-object", "storage": "sqlite" },
		"WorkspaceDO": { "type": "durable-object", "storage": "sqlite" },
		"ReviewerChatAgent": { "type": "durable-object", "storage": "sqlite" }
	},
	"kv_namespaces": [
		{
			"binding": "ENVS_KV"
		},
	],
	"workers_dev": true,
	"preview_urls": false,
	"send_metrics": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
