{
  "name": "tiller-hub",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "TILLER_BUILD_CHANNEL=development vite build && node scripts/deploy-with-region.mjs",
    "log": "wrangler tail",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "cloudflare": {
    "bindings": {
      "TILLER_REGION": {
        "description": "Choose one region code for both the auto-created R2 bucket and Hub Durable Object placement: `wnam` (Western North America), `enam` (Eastern North America), `weur` (Western Europe), `eeur` (Eastern Europe), `apac` (Asia-Pacific), or `oc` (Oceania)."
      }
    }
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.64",
    "@ai-sdk/react": "^3.0.187",
    "@cloudflare/ai-chat": "^0.7.1",
    "@cloudflare/containers": "^0.3.4",
    "@cloudflare/shell": "^0.3.8",
    "@cloudflare/think": "^0.7.0",
    "@cloudflare/voice": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "agents": "^0.13.0",
    "ai": "^6.0.185",
    "diff": "^9.0.0",
    "hono": "^4.12.21",
    "hono-party": "^2.1.0",
    "jose": "^6.2.3",
    "node-diff3": "^3.2.0",
    "partyserver": "^0.5.6",
    "react": "^19.2.6",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.0",
    "workers-ai-provider": "^3.1.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.2",
    "@cloudflare/vitest-pool-workers": "^0.16.7",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "jsonc-parser": "^3.3.1",
    "postcss": "^8.5.15",
    "vite": "^8.0.13",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.0"
  }
}
