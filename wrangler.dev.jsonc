{
	"name": "tiller-hub",
	"main": "api/index.ts",
	"compatibility_date": "2025-01-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"directory": "./dist/client"
	},
	"ai": {
		"binding": "AI"
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
		"vars": {
			"DO_LOCATION_HINT": "wnam",
			"LOCAL_DEV_ONLY_BACKEND": "true"
		},
	"durable_objects": {
		"bindings": [
			{
				"name": "SCHEDULED_RUN_CAPACITY",
				"class_name": "ScheduledRunCapacityDO"
			},
			{
				"name": "ENV_LIFECYCLE",
				"class_name": "EnvLifecycleDO"
			},
			{
				"name": "ARTIFACT_STORE",
				"class_name": "ArtifactStoreDO"
			},
			{
				"name": "HUB",
				"class_name": "HubDO"
			},
			{
				"name": "SANDBOX",
				"class_name": "SandboxDO"
			},
			{
				"name": "TILLER_VOICE",
				"class_name": "TillerVoice"
			},
			{
				"name": "GITHUB_JOB",
				"class_name": "GitHubJobDO"
			},
			{
				"name": "THREAD",
				"class_name": "ThreadDO"
			},
			{
				"name": "WORKSPACE",
				"class_name": "WorkspaceDO"
			},
			{
				"name": "REVIEWER_CHAT",
				"class_name": "ReviewerChatAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"HubDO"
			]
		},
		{
			"tag": "v2",
			"new_classes": [
				"VoiceDO"
			]
		},
		{
			"tag": "v3",
			"deleted_classes": [
				"VoiceDO"
			],
			"new_sqlite_classes": [
				"HapiVoice"
			]
		},
		{
			"tag": "v4",
			"renamed_classes": [
				{
					"from": "HapiVoice",
					"to": "HelmVoice"
				}
			]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": [
				"SandboxDO"
			]
		},
		{
			"tag": "v6",
			"new_sqlite_classes": [
				"WorkspaceDO"
			]
		},
		{
			"tag": "v7",
			"new_sqlite_classes": [
				"ResearchChatAgent"
			]
		},
		{
			"tag": "v8",
			"new_sqlite_classes": [
				"ReviewerChatAgent"
			]
		},
		{
			"tag": "v9",
			"new_sqlite_classes": [
				"PlannerChatAgent"
			]
		},
		{
			"tag": "v10",
			"new_sqlite_classes": [
				"CartographerChatAgent"
			]
		},
		{
			"tag": "v11",
			"new_sqlite_classes": [
				"PlanChatAgent"
			]
		},
		{
			"tag": "v12",
			"renamed_classes": [
				{
					"from": "HelmVoice",
					"to": "TillerVoice"
				}
			]
		},
		{
			"tag": "v13",
			"new_sqlite_classes": [
				"RepoMergeLockDO"
			]
		},
		{
			"tag": "v14",
			"new_sqlite_classes": [
				"ScmBootstrapDO"
			]
		},
		{
			"tag": "v15",
			"new_sqlite_classes": [
				"EnvLifecycleDO"
			]
		},
		{
			"tag": "v16",
			"new_sqlite_classes": [
				"ArtifactStoreDO"
			]
		},
		{
			"tag": "v17",
			"new_sqlite_classes": [
				"ScmOperationDO"
			]
		},
		{
			"tag": "v18",
			"deleted_classes": [
				"PlannerChatAgent"
			]
		},
		{
			"tag": "v19",
			"deleted_classes": [
				"ResearchChatAgent",
				"CartographerChatAgent"
			]
		},
		{
			"tag": "v20",
			"new_sqlite_classes": [
				"ThreadDO"
			]
		},
		{
			"tag": "v21",
			"deleted_classes": [
				"PlanChatAgent"
			]
		},
		{
			"tag": "v22",
			"new_sqlite_classes": [
				"GitHubJobDO"
			],
			"deleted_classes": [
				"RepoMergeLockDO",
				"ScmOperationDO",
				"ScmBootstrapDO"
			]
		},
		{
			"tag": "v23",
			"new_sqlite_classes": [
				"ScheduledRunCapacityDO"
			]
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET"
		}
	],
	"kv_namespaces": [
		{
			"binding": "ENVS_KV"
		},
	],
	"workers_dev": true,
	"send_metrics": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
